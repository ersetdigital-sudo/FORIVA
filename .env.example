# ─────────────────────────────────────────────────────────────
# Supabase — database Postgres + autentikasi admin
# Ambil dari: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────

# URL project Supabase (aman dipublikasikan ke browser)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# Anon/publishable key — dipakai di browser (dilindungi Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi...anon-key..."

# Service role key — HANYA dipakai di server (route handler / server action).
# JANGAN pernah diekspos ke client atau diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...service-role-key..."

# ─────────────────────────────────────────────────────────────
# Cloudinary — penyimpanan gambar QRIS (mode SIGNED)
# Ambil dari: Cloudinary Console → Settings → API Keys
# ─────────────────────────────────────────────────────────────

# Cloud name dipakai di URL upload & URL transformasi gambar
CLOUDINARY_CLOUD_NAME="your-cloud-name"

# API key + secret dipakai server untuk membuat signature upload/delete.
# CLOUDINARY_API_SECRET tidak boleh bocor ke client.
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-api-secret"

# Upload preset (mode signed) yang dipakai saat upload dari dashboard admin
CLOUDINARY_UPLOAD_PRESET="your-upload-preset"

# ─────────────────────────────────────────────────────────────
# Website
# ─────────────────────────────────────────────────────────────

# URL publik situs — dipakai untuk canonical, sitemap.xml, dan OG meta.
# Kalau tidak diisi, fallback ke https://foriva.id di lib/constants.ts
NEXT_PUBLIC_SITE_URL="https://foriva.id"
